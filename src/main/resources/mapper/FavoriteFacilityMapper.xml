<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="inu.voucherview.mapper.FavoriteFacilityMapper">

    <resultMap id="FavoriteFacilityMap" type="inu.voucherview.domain.FavoriteFacility">
        <id column="favorite_id" property="favoriteId"/>
        <result column="user_id" property="userId"/>
        <result column="facility_id" property="facilityId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 찜 추가 -->
    <insert id="insert" parameterType="inu.voucherview.domain.FavoriteFacility">
        INSERT INTO favorite_facility (user_id, facility_id)
        VALUES (#{userId}, #{facilityId})
    </insert>

    <!-- 찜 삭제 -->
    <delete id="delete">
        DELETE FROM favorite_facility
        WHERE user_id = #{userId} AND facility_id = #{facilityId}
    </delete>

    <!-- 찜 여부 확인 -->
    <select id="exists" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM favorite_facility
        WHERE user_id = #{userId} AND facility_id = #{facilityId}
    </select>

    <!-- 사용자의 찜 목록 조회 -->
    <select id="findByUserId" resultMap="FavoriteFacilityMap">
        SELECT favorite_id, user_id, facility_id, created_at
        FROM favorite_facility
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- 시설의 찜 개수 조회 -->
    <select id="countByFacilityId" resultType="int">
        SELECT COUNT(*)
        FROM favorite_facility
        WHERE facility_id = #{facilityId}
    </select>

</mapper>